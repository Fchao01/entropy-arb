# entropy-arb credentials / 密钥配置
#
#   cp .env.example .env     then fill in / 复制后填写
#
# Required to trade (the bot is live-only). Only --record-only data
# collection runs without credentials.
# 交易必填（本机器人只有实盘模式）。仅 --record-only 数据采集不需要密钥。
# NEVER commit .env / 切勿提交 .env 到 git。

# ===== Entropy — Hyperliquid (always required to trade) =====
# ===== Entropy — Hyperliquid 账户（交易必填） =====
# Create an API/agent wallet at https://app.hyperliquid.xyz/API — put the
# AGENT wallet's private key here and your main account address below.
# 在 https://app.hyperliquid.xyz/API 创建 API (agent) 钱包：
# 这里填 agent 钱包私钥，下面填你的主账户地址。
HL_PRIVATE_KEY=
HL_ACCOUNT_ADDRESS=

# ===== --hedge tradexyz (optional overrides) =====
# tradexyz shares the Hyperliquid account above by default. To trade it from
# a separate account/agent key, set these:
# 对冲腿为 tradexyz 时默认与上面共用同一 Hyperliquid 账户；
# 如需独立账户/密钥，填写以下两项：
#HL_PRIVATE_KEY_XYZ=
#HL_ACCOUNT_ADDRESS_XYZ=

# ===== Lighter mainnet / Lighter 主网，主腿或对冲腿均使用这一组 =====
# Mainnet and RH are separate deployments, accounts and API keys.
# See https://github.com/elliottech/lighter-python for key setup.
# 与下方 RH 组分别填写现有 API，交换主腿/对冲腿不交换凭据。
LIGHTER_ACCOUNT_INDEX=
LIGHTER_API_KEY_INDEX=
LIGHTER_API_PRIVATE_KEY=

# ===== RH / Robinhood 链，主腿或对冲腿均使用这一组 =====
# Reuse your existing RH API; these are variable names, not a third API.
# 填现有 RH API，无需新增 API；配置本组后不会使用旧 PRIMARY_LIGHTER_*。
RH_LIGHTER_ACCOUNT_INDEX=
RH_LIGHTER_API_KEY_INDEX=
RH_LIGHTER_API_PRIVATE_KEY=

# ===== --hedge arcus (Arcus perpetuals) =====
# Generate and authorize an API key in the Arcus web app API Keys page.
# The signing key is the 32-byte Ed25519 private seed, 64 hex characters;
# this is NOT your Ethereum wallet private key. Public API Key is derived.
# 在 Arcus 官网 API Keys 页面生成并授权；填 API Signing Key，不是 EVM 钱包私钥。
# Use credentials for the same arcus.network selected in YAML.
ARCUS_ACCOUNT_ADDRESS=
ARCUS_ACCOUNT_INDEX=0
ARCUS_API_SIGNING_KEY=

# ===== Telegram notifications / Telegram 通知 =====
# The web monitor and live engine send alerts only when both values are set.
# BotFather 创建机器人后填写 token；chat_id 可从 getUpdates 或你的群组配置取得。
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Optional primary-leg overrides / 可选主腿凭据覆盖，详见 docs/primary.md。
# Lighter/RH PRIMARY_* names are legacy only, not required for new profiles.
# 旧文件已有 LIGHTER_* 与 PRIMARY_LIGHTER_* 时，不再按主腿猜测网络。
# 可保留现有字段，在 YAML 按实际归属绑定，无须新建/复制 API：
# credentials:
#   lighter-rh: LIGHTER          # 仅当旧 LIGHTER_* 保存的是 RH API
#   lighter: PRIMARY_LIGHTER     # 仅当旧 PRIMARY_LIGHTER_* 保存的是主网 API
# 若旧文件归属相反，上述两项值也应相反。绑定中只写组名，不写私钥。
# 只有一个网络、一个旧凭据组的文件继续兼容；选中的三项不与别组拼接。
#PRIMARY_LIGHTER_ACCOUNT_INDEX=
#PRIMARY_LIGHTER_API_KEY_INDEX=
#PRIMARY_LIGHTER_API_PRIVATE_KEY=
#PRIMARY_HL_PRIVATE_KEY=
#PRIMARY_HL_ACCOUNT_ADDRESS=
# Arcus uses ARCUS_* in either role. PRIMARY_ARCUS_* is a whole-group
# fallback only when no ARCUS_* field is set; never combines both groups.
# Arcus 交换主腿/对冲腿后仍使用 ARCUS_*；只有基础组完全未设置时才整组使用下面的兼容字段。
#PRIMARY_ARCUS_ACCOUNT_ADDRESS=
#PRIMARY_ARCUS_ACCOUNT_INDEX=0
#PRIMARY_ARCUS_API_SIGNING_KEY=
